# Local database
DATABASE_URL="file:./dev.db"

# Development-only Email OTP is displayed in the app only when NODE_ENV is development.
AUTH_MODE="development"
DEV_EMAIL_OTP_CODE="123456"
SESSION_SECRET="replace-with-a-long-random-secret-before-production"

# Local files are used when STORAGE_MODE=local. Production storage is not configured yet.
STORAGE_MODE="local"

# Optional future integrations. The MVP does not require these values.
# Public browser key for the production MapTiler tile source. Empty = local OSM fallback.
NEXT_PUBLIC_MAPTILER_KEY=""
GEOCODING_PROVIDER=""
GEOCODING_API_KEY=""
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
AI_LOCATION_API_KEY=""
